# Copy this file to .env and fill in your own values.
# Never commit .env. The bot reads these at startup and does not print them.
#
# On TopstepX: Settings > API (https://topstepx.com/settings?tab=api)
# userName is the username you use to sign in, not your email and not an account id.

PROJECTX_USERNAME=
PROJECTX_API_KEY=

# Official TopstepX / ProjectX Gateway URLs (gateway.docs.projectx.com).
# Change these only if Topstep gives you different connection URLs.
PROJECTX_API_URL=https://api.topstepx.com
PROJECTX_USER_HUB_URL=https://rtc.topstepx.com/hubs/user
PROJECTX_MARKET_HUB_URL=https://rtc.topstepx.com/hubs/market
